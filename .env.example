# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Application Settings
APP_NAME="5G Resilient School Ecosystems"
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/audit.jsonl

# Knowledge Base
KB_PATH=./data/knowledge_base
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Simulation
SIMULATION_SPEED=normal  # fast, normal, slow

# Edge Gateway (simulated)
EDGE_GATEWAY_ENABLED=true
EDGE_CACHE_SIZE_MB=500
