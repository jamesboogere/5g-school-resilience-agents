# =============================================================
# 5G-Enabled AI Agents for Resilient School Ecosystems
# Team Rein4ce — ITU AI for Good Build-a-thon 5.0
# =============================================================
# Copy this file to .env and fill in your OpenAI API key.
# NEVER commit .env to version control.

# --- REQUIRED ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Optional overrides (defaults shown) ---
OPENAI_MODEL=gpt-4o-mini
APP_NAME=5G Resilient School Ecosystems
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./logs/audit.jsonl
KB_PATH=./data/knowledge_base
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMULATION_SPEED=normal
EDGE_GATEWAY_ENABLED=true
EDGE_CACHE_SIZE_MB=500
